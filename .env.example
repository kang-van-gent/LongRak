# Copy to .env and fill in. Used by docker-compose locally and on the production server.
# Generate secrets with: openssl rand -base64 32

# --- Host ports (local docker-compose only) ---
WEB_PORT=3000
APP_PORT=3001
SERVER_PORT=1337
POSTGRES_PORT=5432

# --- Public URL of the Strapi API, as seen by browsers ---
PUBLIC_API_URL=http://localhost:1337

# --- Database ---
DATABASE_NAME=longrak
DATABASE_USERNAME=longrak
DATABASE_PASSWORD=change-me

# --- Strapi secrets ---
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me
