# Copy to .env and fill in. Used by docker-compose locally and on the production server.
# Generate secrets with: openssl rand -base64 32

# --- Host ports (local docker-compose only) ---
WEB_PORT=3000
APP_PORT=3001
SERVER_PORT=1337
POSTGRES_PORT=5432

# --- Public URL of the Strapi API, as seen by browsers ---
PUBLIC_API_URL=http://localhost:1337

# --- Website → Strapi (web server only) ---
# Create in Strapi admin: Settings → API Tokens → type "Custom", permissions:
#   Lead → submit, Analysis-session → record   (nothing else)
STRAPI_WEBSITE_TOKEN=
# Random salt for hashing visitor IPs in consent receipts (openssl rand -base64 32)
IP_HASH_SALT=
# pgvector embeddings table is created only once the embedding model is chosen, e.g. 1024
KB_EMBEDDING_DIMENSIONS=

# --- AI document checker (web) ---
# n8n webhook that runs the analysis. Leave empty until the workflow is ready:
# the /ai-check page then shows the sample report and says analysis isn't enabled yet.
N8N_WEBHOOK_URL=
# n8n webhook that receives "request a project" after a check (email, role, analysis id)
N8N_PROJECT_WEBHOOK_URL=
# Shared secret sent to both webhooks as the X-LongRak-Secret header (check it in the workflow)
N8N_WEBHOOK_SECRET=

# --- LR-W0-01 analysis job orchestrator (server ↔ n8n) ---
# n8n webhook that receives analysis.job.created events from the Strapi outbox dispatcher.
# Empty ⇒ jobs are accepted (202) but stay "queued" until it is set.
LONGRAK_N8N_EVENT_WEBHOOK_URL=
# Secret the dispatcher sends; must equal n8n's "LongRak Dispatcher Webhook Auth" credential
LONGRAK_N8N_EVENT_WEBHOOK_SECRET=
# Header name of that credential (confirm it in n8n; default X-LongRak-Secret)
LONGRAK_N8N_EVENT_WEBHOOK_SECRET_HEADER=X-LongRak-Secret
# Token n8n sends as "Authorization: Bearer …" to /internal/automation/* (and nowhere else).
# Empty ⇒ the internal API answers 503. openssl rand -base64 48
LONGRAK_INTERNAL_SERVICE_TOKEN=

# --- Database ---
DATABASE_NAME=longrak
DATABASE_USERNAME=longrak
DATABASE_PASSWORD=change-me

# --- Strapi secrets ---
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me
