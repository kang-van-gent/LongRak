{
  "kind": "collectionType",
  "collectionName": "lr_kb_snapshots",
  "info": {
    "singularName": "kb-snapshot",
    "pluralName": "kb-snapshots",
    "displayName": "KB Snapshot",
    "description": "Pinned set of approved source versions, so reports are reproducible"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "public_id": {
      "type": "string",
      "unique": true,
      "minLength": 36,
      "maxLength": 36
    },
    "snapshot_key": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "snapshot_sha256": {
      "type": "string",
      "maxLength": 64
    },
    "compiled_at": {
      "type": "datetime"
    },
    "approved_at": {
      "type": "datetime"
    },
    "snapshot_state": {
      "type": "enumeration",
      "enum": [
        "building",
        "ready",
        "active",
        "retired"
      ],
      "required": true,
      "default": "building"
    },
    "notes": {
      "type": "text"
    }
  }
}
