{
  "kind": "collectionType",
  "collectionName": "lr_plan_catalog_items",
  "info": {
    "singularName": "plan-catalog",
    "pluralName": "plan-catalog-items",
    "displayName": "Plan Catalog",
    "description": "Plans shown on the pricing section. Prices are Early Access hypotheses (real price history = plan_prices, W2)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "public_id": {
      "type": "string",
      "unique": true,
      "minLength": 36,
      "maxLength": 36,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "plan_code": {
      "type": "string",
      "required": true,
      "unique": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "display_name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "billing_model": {
      "type": "enumeration",
      "enum": [
        "per_project",
        "subscription",
        "add_on",
        "free"
      ],
      "required": true,
      "default": "per_project",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "public_state": {
      "type": "enumeration",
      "enum": [
        "draft",
        "active",
        "retired"
      ],
      "required": true,
      "default": "draft",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "feature_summary": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "display_price_amount": {
      "type": "decimal",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "display_price_unit": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "sort_order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
